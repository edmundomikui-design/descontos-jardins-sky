# Configuração da Aplicação
FLASK_ENV=development
DEBUG=True
SECRET_KEY=sua-chave-secreta-super-segura-aqui-mude-em-producao

# Banco de Dados
DATABASE_URL=sqlite:///descontos_jardins_sky.db

# CORS (Domínios permitidos)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,https://descontos-jardins-sky.com.br

# Email (futuro)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# SMS (futuro)
TWILIO_ACCOUNT_SID=seu-account-sid
TWILIO_AUTH_TOKEN=seu-auth-token
TWILIO_PHONE_NUMBER=+55119999999999

# Postos
POSTOS=CAJ,SKY
